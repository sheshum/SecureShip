# Copy to .env and adjust values as needed.

# Backend
# LiteLLM model string, always "<provider>/<model>" (e.g. "anthropic/claude-sonnet-4-5").
LLM_MODEL=ollama_chat/llama3.2
# Base URL the backend container uses to reach Ollama on the host.
# Not needed for hosted providers (set LLM_API_KEY instead).
LLM_API_BASE=http://host.docker.internal:11434

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
