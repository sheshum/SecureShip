#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "pre-push: running frontend oxlint"
(
  cd frontend
  npm run lint
)

echo "pre-push: running backend ruff check"
(
  cd backend
  uv run ruff check .
)

echo "pre-push: running backend migration sanity checks"
(
  cd backend
  migration_found=false

  while IFS= read -r migration_file; do
    [[ -z "$migration_file" ]] && continue
    migration_found=true
    uv run ruff check --select F,E9 "$migration_file"
  done < <(find alembic/versions -type f -name '*.py' | sort)

  if [[ "$migration_found" == false ]]; then
    echo "pre-push: no migration scripts found"
  fi
)
