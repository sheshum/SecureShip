# Copy to .env (in this backend/ folder) and adjust values as needed.
# Loaded via Settings' env_file=".env" (app/core/config.py), relative to
# whatever directory the backend process is run from (backend/ for local dev).

# Admin dashboard auth (Auth0) — protects GET /api/sessions, /api/shipments,
# /api/packages. Leave unset to run without protecting those routes.
# Domain of the Auth0 tenant, no "https://" prefix.
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Identifier of the custom Auth0 API resource (Applications -> APIs) created
# for this backend — NOT the built-in Auth0 Management API.
AUTH0_AUDIENCE=https://secureship-admin-api
